
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f1f5f9;
  color: #1e293b;
}

.container {
  max-width: 850px;
  margin: 50px auto;
  padding: 30px;
  background: white;
  border-radius: 12px;
}

h1 {
  color: #2563eb;
}

form {
  display: grid;
  gap: 12px;
  margin: 25px 0;
}

input {
  padding: 12px;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
}

button {
  padding: 10px 16px;
  border: none;
  border-radius: 6px;
  background: #2563eb;
  color: white;
  cursor: pointer;
  margin-right: 8px;
}

.student {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px;
  border-bottom: 1px solid #e2e8f0;
}

.error {
  color: red;
}

